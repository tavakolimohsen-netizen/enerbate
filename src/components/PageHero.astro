---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  crumbs?: { href: string; label: string }[];
}
const { eyebrow, title, lede, crumbs = [] } = Astro.props;
---

<section class="border-b border-line bg-surface">
  <div class="wrap py-12 md:py-16">
    {
      crumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="mb-5">
          <ol class="flex flex-wrap items-center gap-1.5 text-sm text-body">
            {crumbs.map((c) => (
              <li class="flex items-center gap-1.5">
                <a href={c.href} class="hover:text-teal-600 hover:underline">
                  {c.label}
                </a>
                <span aria-hidden="true">/</span>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="mt-3 max-w-4xl text-4xl md:text-5xl">{title}</h1>
    {lede && <p class="mt-5 max-w-3xl text-lg leading-relaxed">{lede}</p>}
  </div>
</section>
