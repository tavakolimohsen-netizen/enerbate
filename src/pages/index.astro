---
import Base from '../layouts/Base.astro';
import {
  company,
  services,
  regions,
  projects,
  differentiators,
  projectTypes,
} from '../data/site';

const stats = [
  { figure: '150+', label: 'Units modelled', note: 'Multi-family projects across BC' },
  { figure: '5–10', label: 'Days turnaround', note: 'For most standard projects' },
  { figure: '2', label: 'Code paths', note: 'Part 3 and Part 9 compliance' },
];

const codeBadges = [
  'BC Energy Step Code',
  'NECB',
  'OBC SB-10',
  'Toronto Green Standard',
  'CSA F-280-12',
  'ASHRAE 90.1',
  'CMHC MLI Select',
];
---

<Base
  title="EnerBate Solutions — Energy modelling and compliance reporting in Canada"
  bareTitle
  description="Energy modelling, compliance reporting and building energy audits for Canadian building professionals. BC Energy Step Code, NECB, OBC SB-10, Toronto Green Standard and CSA F-280. Most projects delivered in 5–10 days."
>
  <!-- ================= HERO ================= -->
  <section class="relative isolate overflow-hidden bg-navy-800">
    <!-- Hero media. The poster paints first at every width; the video sits
         on top of it and fades in once it can actually play. If the browser
         refuses to autoplay, or the visitor is on a metered/slow connection,
         or asks for reduced motion, the poster simply stays. -->
    <img
      src="/images/hero-poster.webp"
      alt=""
      aria-hidden="true"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover opacity-[0.55]"
    />

    <video
      data-hero
      class="absolute inset-0 h-full w-full object-cover opacity-[0.55]"
      poster="/images/hero-poster.webp"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-hidden="true"
      tabindex="-1"
    >
      <!-- VP9 first: 322 KB vs 518 KB. Safari and older Android take the mp4. -->
      <source src="/videos/hero.webm" type="video/webm" />
      <source src="/videos/hero.mp4" type="video/mp4" />
    </video>

    <div class="hero-veil absolute inset-0" aria-hidden="true"></div>

    <div class="wrap relative py-20 md:py-28 lg:py-32">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-spark-300">
          Energy modelling &amp; compliance · Canada
        </p>
        <h1 class="mt-4 text-4xl font-extrabold text-white sm:text-5xl lg:text-[3.4rem]">
          The energy report your permit is waiting on.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-navy-100">
          EnerBate builds calibrated energy models and the compliance reports that
          come out of them — Step Code, NECB, SB-10, Toronto Green Standard and
          CSA F-280. Most standard projects are delivered in {company.turnaround}.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/contact/" class="btn btn-onDark">Request a quote</a>
          <a
            href="/services/"
            class="btn border border-white/25 text-white hover:bg-white/10"
          >
            See what we model
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= PROOF ================= -->
  <section aria-label="Track record" class="border-b border-line bg-surface">
    <div class="wrap py-12">
      <dl class="grid gap-8 sm:grid-cols-3">
        {
          stats.map((s) => (
            <div>
              <dt class="sr-only">{s.label}</dt>
              <dd>
                <span class="block text-4xl font-extrabold tracking-tight text-navy-800">
                  {s.figure}
                </span>
                <span class="mt-1 block font-semibold text-navy-700">{s.label}</span>
                <span class="mt-0.5 block text-sm text-body">{s.note}</span>
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-10 border-t border-line pt-8">
        <p class="text-xs font-semibold uppercase tracking-wider text-body">
          Code paths and programmes we report to
        </p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {
            codeBadges.map((c) => (
              <li class="rounded-full border border-navy-200 bg-white px-3.5 py-1.5 text-sm font-medium text-navy-700">
                {c}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ================= SERVICES ================= -->
  <section class="wrap py-20 md:py-24" aria-labelledby="services-h">
    <div class="max-w-2xl">
      <p class="eyebrow">Services</p>
      <h2 id="services-h" class="mt-3 text-3xl md:text-4xl">
        Modelling, audits and the reports that come out of them
      </h2>
      <p class="mt-4 text-lg">
        Six services that cover a building from permit application through to
        post-occupancy verification.
      </p>
    </div>

    <ul class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        services.map((s) => (
          <li class="card group flex flex-col p-6">
            <h3 class="text-lg">
              <a href={`/services/${s.slug}/`} class="after:absolute after:inset-0 relative">
                {s.title}
              </a>
            </h3>
            <p class="mt-2.5 flex-1 text-[0.9375rem]">{s.short}</p>
            <p class="mt-4 flex items-center gap-1.5 text-sm font-semibold text-teal-600">
              Learn more
              <svg
                width="15" height="15" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                stroke-linejoin="round" aria-hidden="true"
                class="transition-transform group-hover:translate-x-0.5"
              >
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ================= WHY US ================= -->
  <section class="bg-navy-800 py-20 md:py-24" aria-labelledby="why-h">
    <div class="wrap">
      <div class="max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-spark-300">
          Why EnerBate
        </p>
        <h2 id="why-h" class="mt-3 text-3xl text-white md:text-4xl">
          Built to pass review the first time
        </h2>
      </div>

      <ul class="mt-12 grid gap-x-10 gap-y-9 md:grid-cols-2 lg:grid-cols-3">
        {
          differentiators.map((d) => (
            <li>
              <h3 class="flex items-start gap-2.5 text-lg text-white">
                <svg
                  width="20" height="20" viewBox="0 0 24 24" fill="none"
                  stroke="#97D099" stroke-width="2.5" stroke-linecap="round"
                  stroke-linejoin="round" aria-hidden="true" class="mt-0.5 shrink-0"
                >
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                {d.title}
              </h3>
              <p class="mt-2 pl-[1.875rem] text-[0.9375rem] leading-relaxed text-navy-200">
                {d.body}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ================= PROJECTS ================= -->
  <section class="wrap py-20 md:py-24" aria-labelledby="projects-h">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <p class="eyebrow">Selected work</p>
        <h2 id="projects-h" class="mt-3 text-3xl md:text-4xl">Projects we have modelled</h2>
      </div>
      <a href="/projects/" class="link-teal">All projects &rarr;</a>
    </div>

    <ul class="mt-12 grid gap-6 md:grid-cols-3">
      {
        projects.map((p) => (
          <li class="card group overflow-hidden">
            <div class="flex aspect-[4/3] items-center justify-center overflow-hidden bg-navy-50">
              <img
                src={p.images[0].src}
                alt={p.images[0].alt}
                decoding="async"
                width="640"
                height="480"
                class="h-full w-full object-contain p-4 transition-transform duration-500 group-hover:scale-[1.03]"
              />
            </div>
            <div class="p-6">
              <p class="text-xs font-semibold uppercase tracking-wider text-teal-600">
                {p.type}
              </p>
              <h3 class="mt-2 text-lg">
                <a href={`/projects/#${p.slug}`} class="hover:text-teal-600">
                  {p.name}
                </a>
              </h3>
              <p class="mt-1 text-sm text-body">{p.location}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ================= REGIONS ================= -->
  <section class="border-y border-line bg-surface py-20 md:py-24" aria-labelledby="regions-h">
    <div class="wrap">
      <div class="max-w-2xl">
        <p class="eyebrow">Where we work</p>
        <h2 id="regions-h" class="mt-3 text-3xl md:text-4xl">
          Every province files under a different path
        </h2>
        <p class="mt-4 text-lg">
          A reference model built to the wrong code path has to be built again.
          We confirm which one applies before any modelling starts.
        </p>
      </div>

      <ul class="mt-12 grid gap-5 md:grid-cols-3">
        {
          regions.map((r) => (
            <li class="card group relative p-6">
              <h3 class="text-xl">
                <a href={`/regions/${r.slug}/`} class="after:absolute after:inset-0">
                  {r.name}
                </a>
              </h3>
              <p class="mt-2.5 text-[0.9375rem]">{r.short}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ================= PROJECT TYPES ================= -->
  <section class="wrap py-20 md:py-24" aria-labelledby="types-h">
    <h2 id="types-h" class="max-w-2xl text-3xl md:text-4xl">Project types we serve</h2>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {
        projectTypes.map((t) => (
          <li class="rounded-lg border border-line p-5">
            <h3 class="text-base">{t.name}</h3>
            <p class="mt-1.5 text-sm">{t.note}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ================= CTA ================= -->
  <section class="wrap pb-8" aria-labelledby="cta-h">
    <div class="rounded-2xl bg-navy-800 px-6 py-14 text-center md:px-16 md:py-16">
      <h2 id="cta-h" class="text-3xl text-white md:text-4xl">
        Send us the drawings. We&rsquo;ll send back a quote.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-navy-200">
        Tell us the project type, the municipality and the code path you are
        filing under — that is usually enough for a firm price and a delivery date.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href="/contact/" class="btn btn-onDark">Request a quote</a>
        <a href={company.phoneHref} class="btn border border-white/25 text-white hover:bg-white/10">
          Call {company.phone}
        </a>
      </div>
    </div>
  </section>

  <script>
    // Mobile browsers do not reliably start an autoplaying video on their own,
    // and some refuse outright. Ask once, retry when the data arrives, and fall
    // back to the poster underneath without complaining.
    const hero = document.querySelector('video[data-hero]') as HTMLVideoElement | null;

    if (hero) {
      const conn = (navigator as any).connection;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const thin = conn?.saveData === true || /(^|-)2g$/.test(conn?.effectiveType ?? '');

      if (reduced || thin) {
        // Never fetch it at all — the poster is already on screen.
        hero.remove();
      } else {
        const nudge = () => hero.play().catch(() => {});
        nudge();
        hero.addEventListener('loadeddata', nudge, { once: true });
        hero.addEventListener('canplay', nudge, { once: true });
        document.addEventListener('visibilitychange', () => {
          if (!document.hidden) nudge();
        });
      }
    }
  </script>
</Base>
