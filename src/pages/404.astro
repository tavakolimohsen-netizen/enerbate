---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That page does not exist on enerbate.ca.">
  <section class="wrap py-24 text-center md:py-32">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-4xl md:text-5xl">That page does not exist</h1>
    <p class="mx-auto mt-5 max-w-lg text-lg">
      The link may be out of date. The services and project pages are the best
      place to pick the thread back up.
    </p>
    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn-primary">Back to home</a>
      <a href="/services/" class="btn btn-ghost">See services</a>
    </div>
  </section>
</Base>
