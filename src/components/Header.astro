---
import { company, services, regions } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

const nav = [
  { href: '/services/', label: 'Services' },
  { href: '/regions/', label: 'Where we work' },
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
];
---

<header class="sticky top-0 z-50 border-b border-line bg-white/95 backdrop-blur">
  <div class="wrap flex items-center justify-between gap-4 py-3">
    <a
      href="/"
      class="flex shrink-0 items-center rounded"
      aria-label={`${company.shortName} — home`}
    >
      <img
        src="/images/enerbate-logo.svg"
        alt={company.name}
        width="197"
        height="60"
        class="h-9 w-auto md:h-10"
      />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-2 text-[0.9375rem] font-medium transition-colors',
              isActive(item.href)
                ? 'text-teal-600'
                : 'text-navy-700 hover:bg-navy-50',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={company.phoneHref}
        class="hidden text-[0.9375rem] font-semibold text-navy-800 hover:text-teal-600 md:inline"
      >
        {company.phone}
      </a>
      <a href="/contact/" class="btn btn-primary">Request a quote</a>
      <button
        type="button"
        id="navToggle"
        class="inline-flex h-11 w-11 items-center justify-center rounded-md border border-navy-200 lg:hidden"
        aria-expanded="false"
        aria-controls="mobileNav"
        aria-label="Open menu"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#203459" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobileNav" hidden class="border-t border-line bg-white lg:hidden">
    <nav class="wrap flex flex-col py-3" aria-label="Main, mobile">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="rounded-md px-2 py-3 font-medium text-navy-800 hover:bg-navy-50"
          >
            {item.label}
          </a>
        ))
      }
      <div class="mt-2 border-t border-line pt-3">
        <p class="px-2 pb-2 text-xs font-semibold uppercase tracking-wider text-body">
          Services
        </p>
        {
          services.map((s) => (
            <a
              href={`/services/${s.slug}/`}
              class="block rounded-md px-2 py-2.5 text-[0.9375rem] text-body hover:bg-navy-50"
            >
              {s.title}
            </a>
          ))
        }
      </div>
      <div class="mt-2 border-t border-line pt-3">
        <p class="px-2 pb-2 text-xs font-semibold uppercase tracking-wider text-body">
          Where we work
        </p>
        {
          regions.map((r) => (
            <a
              href={`/regions/${r.slug}/`}
              class="block rounded-md px-2 py-2.5 text-[0.9375rem] text-body hover:bg-navy-50"
            >
              {r.name}
            </a>
          ))
        }
      </div>
      <a href={company.phoneHref} class="mt-3 px-2 py-2 font-semibold text-teal-600">
        {company.phone}
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('navToggle');
  const panel = document.getElementById('mobileNav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    if (panel) panel.hidden = open;
  });
</script>
