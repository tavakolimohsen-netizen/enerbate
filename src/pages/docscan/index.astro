---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';

const playUrl = 'https://play.google.com/store/apps/details?id=ca.enerbate.docscan';
// Official badge, hosted by Google (Google Play badge guidelines).
const badge = 'https://play.google.com/intl/en_us/badges/static/images/badges/en_badge_web_generic.png';

const shots = [
  { src: '/images/docscan/home.webp', alt: 'DocScan document library with scanned invoice, letter and receipt' },
  { src: '/images/docscan/page.webp', alt: 'A scanned invoice shown full page in DocScan' },
  { src: '/images/docscan/ocr_letter.webp', alt: 'Text recognised from a scanned letter, ready to copy' },
  { src: '/images/docscan/tools.webp', alt: 'DocScan tools: book scanning, ID card copy, images to PDF, merge and split PDFs' },
];

const groups = [
  {
    title: 'Scan',
    items: [
      'Automatic page detection and cropping, multi-page documents',
      'Book mode: two pages per photo, split automatically',
      'ID card mode: front and back on one page at true size',
      'Flatten curved book pages, remove moiré from screen photos',
    ],
  },
  {
    title: 'Recognise text, offline',
    items: [
      '16 languages built in, with strong Persian and Arabic support',
      'Searchable PDFs; select and copy text right on the image',
      'Tables to Excel, text to Word or TXT',
    ],
  },
  {
    title: 'PDF tools',
    items: [
      'Page size, margins, page numbers, password protection',
      'Merge, split, compress, fill PDF forms, PDF to images',
      'Signatures, stamps and watermarks',
    ],
  },
  {
    title: 'Private by design',
    items: [
      'No internet permission at all: documents never leave the phone',
      'No account, no ads, no tracking',
      'App lock and locked folders with fingerprint',
    ],
  },
];
---

<Base
  title="DocScan — offline document scanner"
  description="DocScan is a free, offline document scanner for Android from EnerBate Solutions Inc.: scan to PDF, recognise text in 16 languages, and keep every document on your phone."
>
  <PageHero
    eyebrow="Android app"
    title="DocScan: a document scanner that never goes online"
    lede="Scan papers to PDF, recognise their text in 16 languages and organise them — all on your phone. DocScan has no internet permission, no account, no ads and no tracking, and nothing is locked behind a payment."
    crumbs={[{ href: '/', label: 'Home' }]}
  />

  <section class="wrap grid items-center gap-10 py-12 md:grid-cols-[auto_1fr] md:py-16">
    <img src="/images/docscan/docscan-icon.webp" alt="DocScan app icon" width="128" height="128"
         class="h-28 w-28 rounded-[1.75rem] shadow-md md:h-32 md:w-32" />
    <div>
      <p class="text-lg leading-relaxed">
        Free on Google Play for Android 7.0 and newer, in English, Persian, Arabic, Urdu, Spanish,
        Portuguese, French, German, Italian, Russian, Turkish, Indonesian, Hindi, Chinese, Japanese
        and Korean.
      </p>
      <a href={playUrl} class="mt-5 inline-block" rel="noopener">
        <img src={badge} alt="Get it on Google Play" width="216" height="64" class="h-16 w-auto -ml-3" />
      </a>
    </div>
  </section>

  <section class="border-y border-line bg-surface" aria-labelledby="shots-h">
    <div class="wrap py-12 md:py-16">
      <h2 id="shots-h" class="text-2xl md:text-3xl">A look inside</h2>
      <ul class="mt-8 grid grid-cols-2 gap-5 md:grid-cols-4">
        {shots.map((s) => (
          <li>
            <img src={s.src} alt={s.alt} width="540" height="1080" loading="lazy"
                 class="w-full rounded-2xl border border-line shadow-sm" />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="wrap py-12 md:py-16" aria-labelledby="feat-h">
    <h2 id="feat-h" class="text-2xl md:text-3xl">What it does</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {groups.map((g) => (
        <div class="card p-6">
          <h3 class="text-lg">{g.title}</h3>
          <ul class="mt-3 space-y-2 text-[0.9375rem]">
            {g.items.map((i) => (
              <li class="flex gap-2"><span aria-hidden="true" class="text-teal-600">•</span><span>{i}</span></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-navy-800 text-navy-100" aria-labelledby="give-h">
    <div class="wrap grid gap-6 py-12 md:grid-cols-[1fr_auto] md:items-center md:py-16">
      <div>
        <h2 id="give-h" class="text-2xl text-white md:text-3xl">Free, with an optional contribution</h2>
        <p class="mt-3 max-w-3xl leading-relaxed">
          Every feature is free. Inside the app you can choose to make a contribution through Google
          Play; EnerBate gives the net proceeds to orphans, people in need, stranded travellers and
          refugees — so that wealth does not circulate only among the rich.
        </p>
      </div>
      <a href={playUrl} class="btn btn-onDark" rel="noopener">Install DocScan</a>
    </div>
  </section>

  <section class="wrap py-12 text-[0.9375rem]">
    <p>
      Questions or suggestions:{' '}<a class="text-teal-600 hover:underline" href="mailto:energy@enerbate.ca">energy@enerbate.ca</a>{' · '}<a class="text-teal-600 hover:underline" href="/docscan/privacy/">Privacy policy</a>
    </p>
    <p class="mt-2 text-sm text-body">Google Play and the Google Play logo are trademarks of Google LLC.</p>
  </section>
</Base>
