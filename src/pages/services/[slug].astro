---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { services, company, type Service } from '../../data/site';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

interface Props { service: Service }
const { service } = Astro.props;
const others = services.filter((s) => s.slug !== service.slug).slice(0, 3);
---

<Base title={service.title} description={service.summary}>
  <PageHero
    eyebrow="Service"
    title={service.title}
    lede={service.summary}
    crumbs={[
      { href: '/', label: 'Home' },
      { href: '/services/', label: 'Services' },
    ]}
  />

  <div class="wrap grid gap-14 py-16 md:py-20 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-16">
    <article class="prose-b max-w-2xl text-[1.0625rem] leading-relaxed">
      <p class="text-xl leading-relaxed text-navy-700">{service.intro}</p>

      {
        service.sections.map((sec) => (
          <section class="mt-10">
            <h2 class="text-2xl">{sec.heading}</h2>
            <p class="mt-3">{sec.body}</p>
            {sec.bullets && (
              <ul class="mt-4 space-y-2">
                {sec.bullets.map((b) => (
                  <li class="flex gap-2.5">
                    <svg
                      width="18" height="18" viewBox="0 0 24 24" fill="none"
                      stroke="#09768A" stroke-width="2.5" stroke-linecap="round"
                      stroke-linejoin="round" aria-hidden="true" class="mt-1 shrink-0"
                    >
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))
      }
    </article>

    <aside class="lg:sticky lg:top-24 lg:self-start">
      <div class="card p-6">
        <h2 class="text-base">You receive</h2>
        <p class="mt-2 text-[0.9375rem]">{service.deliverable}</p>

        <h3 class="mt-6 text-sm font-semibold uppercase tracking-wider text-body">
          Standards
        </h3>
        <ul class="mt-3 flex flex-wrap gap-1.5">
          {
            service.codes.map((c) => (
              <li class="rounded border border-line bg-surface px-2 py-1 text-xs font-medium text-navy-700">
                {c}
              </li>
            ))
          }
        </ul>

        <p class="mt-6 border-t border-line pt-5 text-[0.9375rem]">
          Typical turnaround for standard projects is {company.turnaround}.
        </p>
        <a href="/contact/" class="btn btn-primary mt-5 w-full">Request a quote</a>
        <p class="mt-3 text-center text-sm">
          or call
          <a class="link-teal" href={company.phoneHref}>{company.phone}</a>
        </p>
      </div>
    </aside>
  </div>

  <section class="border-t border-line bg-surface py-16">
    <div class="wrap">
      <h2 class="text-2xl">Other services</h2>
      <ul class="mt-8 grid gap-5 md:grid-cols-3">
        {
          others.map((s) => (
            <li class="card group relative bg-white p-6">
              <h3 class="text-lg">
                <a href={`/services/${s.slug}/`} class="after:absolute after:inset-0">
                  {s.title}
                </a>
              </h3>
              <p class="mt-2 text-[0.9375rem]">{s.short}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
