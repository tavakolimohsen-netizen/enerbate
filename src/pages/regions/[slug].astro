---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { regions, services, company, type Region } from '../../data/site';

export function getStaticPaths() {
  return regions.map((r) => ({ params: { slug: r.slug }, props: { region: r } }));
}

interface Props { region: Region }
const { region } = Astro.props;
---

<Base
  title={`Energy modelling in ${region.name}`}
  description={`${region.short} EnerBate delivers energy models and compliance reports for projects in ${region.name}.`}
>
  <PageHero
    eyebrow="Where we work"
    title={`Energy modelling in ${region.name}`}
    lede={region.intro}
    crumbs={[
      { href: '/', label: 'Home' },
      { href: '/regions/', label: 'Where we work' },
    ]}
  />

  <div class="wrap grid gap-14 py-16 md:py-20 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-16">
    <div class="max-w-2xl">
      <section>
        <h2 class="text-2xl">Code paths</h2>
        <dl class="mt-6 divide-y divide-line border-y border-line">
          {
            region.codes.map((c) => (
              <div class="grid gap-1 py-4 sm:grid-cols-[14rem_1fr] sm:gap-6">
                <dt class="font-semibold text-navy-800">{c.name}</dt>
                <dd class="text-[0.9375rem]">{c.note}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="mt-12">
        <h2 class="text-2xl">Programmes we prepare applications for</h2>
        <ul class="mt-5 grid gap-2.5 sm:grid-cols-2">
          {
            region.programmes.map((p) => (
              <li class="flex gap-2.5 text-[0.9375rem]">
                <svg
                  width="18" height="18" viewBox="0 0 24 24" fill="none"
                  stroke="#09768A" stroke-width="2.5" stroke-linecap="round"
                  stroke-linejoin="round" aria-hidden="true" class="mt-1 shrink-0"
                >
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                <span>{p}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mt-12">
        <h2 class="text-2xl">Where we have worked</h2>
        <p class="mt-3 text-[1.0625rem] leading-relaxed">{region.experience}</p>
      </section>
    </div>

    <aside class="lg:sticky lg:top-24 lg:self-start">
      <div class="card p-6">
        <h2 class="text-base">Services available here</h2>
        <ul class="mt-4 space-y-2.5">
          {
            services.map((s) => (
              <li>
                <a class="text-[0.9375rem] link-teal" href={`/services/${s.slug}/`}>
                  {s.title}
                </a>
              </li>
            ))
          }
        </ul>
        <a href="/contact/" class="btn btn-primary mt-6 w-full">Request a quote</a>
        <p class="mt-3 text-center text-sm">
          or call <a class="link-teal" href={company.phoneHref}>{company.phone}</a>
        </p>
      </div>
    </aside>
  </div>
</Base>
