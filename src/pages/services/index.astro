---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { services } from '../../data/site';
---

<Base
  title="Services"
  description="Energy modelling, energy audits, CSA F-280 heat loss and gain, overheating analysis, compliance reporting and accessibility reporting for Canadian building projects."
>
  <PageHero
    eyebrow="Services"
    title="What we model, and what you receive"
    lede="Six services covering a building from permit application through to post-occupancy verification. Each one ends in a document a reviewer can act on."
    crumbs={[{ href: '/', label: 'Home' }]}
  />

  <section class="wrap py-16 md:py-20">
    <ul class="grid gap-6 md:grid-cols-2">
      {
        services.map((s) => (
          <li class="card group relative flex flex-col p-7">
            <h2 class="text-xl">
              <a href={`/services/${s.slug}/`} class="after:absolute after:inset-0">
                {s.title}
              </a>
            </h2>
            <p class="mt-3 flex-1 leading-relaxed">{s.summary}</p>
            <ul class="mt-5 flex flex-wrap gap-1.5">
              {s.codes.map((c) => (
                <li class="rounded border border-line bg-surface px-2 py-1 text-xs font-medium text-navy-700">
                  {c}
                </li>
              ))}
            </ul>
            <p class="mt-5 text-sm font-semibold text-teal-600">
              Read more &rarr;
            </p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
